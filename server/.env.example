# Clé API Anthropic — requise pour la génération des propositions de
# réconciliation (vue "Réconciliation" du mode présentation). Jamais commitée
# (voir .gitignore). Copier ce fichier en `.env` et renseigner la vraie clé.
ANTHROPIC_API_KEY=

# Modèle utilisé pour la génération — configurable, non codé en dur.
# Défaut si absent : claude-sonnet-5
SOP_LLM_MODEL=claude-sonnet-5

# Origine autorisée en CORS (le domaine du frontend déployé). Défaut si absent :
# https://empathetic-benevolence-production-cd6a.up.railway.app
CORS_ORIGIN=
